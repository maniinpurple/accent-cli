# Copy to .env and fill in the keys you want to use (both are optional).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: whisper model for transcription (base.en is fast; small.en is more accurate)
# ACCENT_WHISPER_MODEL=base.en
